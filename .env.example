# ---------------------------------------------------------------------------
# Copy to ".env" and edit. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Flask ---------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-going-live
FLASK_ENV=development

# MySQL ---------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=clocking
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=clocking
# TLS to the database. Leave blank to decide automatically: "disabled" for a
# database on this machine, "verify-identity" for anything remote - a managed
# database (DigitalOcean, RDS, Azure) is reached over the public internet, and
# face templates are biometric data, so the link must be encrypted.
#   disabled         no TLS. Only acceptable for localhost.
#   required         encrypt, but do not verify the server's certificate.
#   verify-identity  encrypt and verify the certificate and hostname.
MYSQL_SSL_MODE=
# The CA certificate your provider issues. A managed database signs with its
# own private CA, which is NOT in this machine's trust store - so without this,
# "verify-identity" fails with "self-signed certificate in certificate chain",
# and it fails on the first query rather than at start-up.
#
# For DigitalOcean, download "ca-certificate.crt" from the database's Connection
# Details page. It is a public certificate, not a secret.
#
# An absolute path is used as given; a relative one is resolved against the
# project root, so a certificate committed to the repository works anywhere.
#
# You can leave this blank: a certificate committed at certs/ca-certificate.crt
# is used automatically. That is the easiest route on a platform whose
# environment is edited in a web console (DigitalOcean App Platform, Heroku,
# Render) - the certificate travels with the code, so there is no variable to
# remember and nothing that can drift out of step with the repository.
MYSQL_SSL_CA=
# Or paste the certificate text instead of a path - for a platform with config
# vars and no persistent filesystem (Heroku, Render, Fly). If both are set, the
# path above wins.
MYSQL_SSL_CA_PEM=

# Reverse proxy -------------------------------------------------------------
# How many proxies sit in front of this app. 0 (the default) ignores the
# X-Forwarded-* headers, which is right on the office LAN - nothing strips them
# there, so trusting them would let anything on the network claim any address.
#
# Set this to 1 on a hosting platform (DigitalOcean App Platform, Heroku,
# Render), where every request arrives through the platform's load balancer.
# Without it the app sees the balancer as the client, so the login rate limit
# puts every user in one bucket and one person guessing badly locks out the lot.
TRUSTED_PROXY_COUNT=0

# Kiosk ---------------------------------------------------------------------
# Shared secret the kiosk browser must present. Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KIOSK_TOKEN=change-me-kiosk-token
KIOSK_DEVICE_LABEL=Workshop entrance
# Let somebody clock by typing their payroll number, for when the camera cannot
# see them. A payroll number is an IDENTIFIER, NOT A SECRET - it is printed on
# payslips and known to colleagues - so anybody who knows a number can clock as
# that person. Entries made this way are stored with method "keypad" so the
# office can see which ones were typed rather than recognised. Set this to false
# if that trade is not acceptable on your floor.
KIOSK_KEYPAD_MODE=true

# Hands-free clocking -------------------------------------------------------
# true: the kiosk watches for a face and clocks people with no button press.
# false: nothing happens until somebody presses Scan.
KIOSK_AUTO_MODE=true
# Seconds the on-screen countdown runs before an automatic entry is written.
# This is the safety net: it lets somebody who only walked past press Cancel.
# Set to 0 to record the instant a face is recognised (not recommended).
AUTO_CONFIRM_SECONDS=2
# Minimum gap between two AUTOMATIC entries for the same person. Deliberately
# long: being seen by a camera states no intent, so somebody crossing the view
# an hour into their shift must not be clocked out. Pressing Clock out overrides
# it. Raise it towards a full shift length if people pass the kiosk often.
# How often recognition runs once the kiosk thinks somebody is there (ms).
AUTO_POLL_MS=600
# How often the browser checks whether anybody has arrived (ms). Cheap: this is
# a small greyscale comparison in the browser, not face recognition.
AUTO_PRESENCE_MS=200
# Mean grey-level change from the empty scene that counts as "somebody is
# there". Raise it if the kiosk keeps waking at shadows or passing forklifts;
# lower it if it ignores people who approach slowly.
AUTO_PRESENCE_THRESHOLD=7.0
# In hands-free mode the nearest face must be this many times wider than the
# next one to count as "the person at the kiosk", so somebody walking past
# behind does not block recognition. Raise it to be stricter.
FACE_DOMINANT_RATIO=1.35

# Recognition tuning --------------------------------------------------------
# Cosine similarity required to accept a match (SFace: 0.363 is the OpenCV
# reference value; raise towards 0.45 to reduce false accepts).
FACE_MATCH_THRESHOLD=0.40
# The best match must beat the runner-up by at least this margin.
FACE_MATCH_MARGIN=0.05
# Minimum face width in pixels, as seen by the detector.
FACE_MIN_PIXELS=55
# Minimum Laplacian variance (blur gate). Lower = accepts blurrier images.
FACE_MIN_SHARPNESS=45.0
# Frames the kiosk sends per scan, and how many must agree.
SCAN_FRAMES=3
SCAN_MIN_AGREE=2
# Require frame-to-frame movement (basic printed-photo deterrent).
LIVENESS_REQUIRE_MOTION=true
LIVENESS_MIN_MOTION=1.6

# Payroll -------------------------------------------------------------------
# Key for the encrypted hourly-rate columns on the employee record. Generate one
# with:  flask --app wsgi payroll-key
# Leave it blank and a key is derived from SECRET_KEY, which works but means
# rotating SECRET_KEY makes every stored pay rate unreadable. Set a real one in
# production, keep it with your other secrets, and back it up separately from
# the database - the rates cannot be recovered without it.
PAYROLL_KEY=
# Four-weekly payroll: the Monday that period 1 of the payroll year starts on.
# The master sheet counts 28-day periods from here to fill in "Period:".
PAYROLL_PERIOD_1_START=2026-03-30
PAYROLL_PERIODS_PER_YEAR=13
PAYROLL_COMPANY_NAME=Moduflex Ltd

# Dashboard -----------------------------------------------------------------
# The office dashboard reloads itself so a screen left open on it stays current.
# Each reload re-reads the running payroll period, so raise this if the page is
# left up all day on a slow connection. 0 turns the reload off.
DASHBOARD_REFRESH_SECONDS=30

# Attendance rules ----------------------------------------------------------
# Ignore repeat scans from the same person within this many seconds.
CLOCK_COOLDOWN_SECONDS=5
# Local timezone used for day boundaries and reports.
TIMEZONE=Europe/London
FACE_DETECT_MAX_SIDE=960
CAPTURE_MAX_WIDTH=960
AUTO_SCAN_FRAMES=2
AUTO_FRAME_GAP_MS=300
AUTO_REQUIRE_DEPARTURE=false
AUTO_DEPARTURE_MS=900
AUTO_REARM_SECONDS=30
# While latched, ask the server whether anybody is still in front of the camera.
# The face detector is a far more reliable judge of that than the browser's
# grey-difference check, so it is the authority for deciding somebody has left.
# This is what stops clocking becoming unpredictable after the first scan.
AUTO_LATCHED_POLL_MS=1500
# Slow safety poll for when the presence check says "empty" but somebody really
# is standing there (dark clothing, awkward angle, threshold set too high).
# Without it such a person is never clocked and nothing says why. 0 disables it.
AUTO_IDLE_POLL_MS=4000
